{
  "name": "db-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server/index.ts\" \"vite --host 127.0.0.1 --port 5173 --strictPort\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration:sqlite": "vitest run tests/integration/sqlite-*.test.ts --no-file-parallelism",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:browser-fixture": "tsx tests/mysql/browser-fixture.ts",
    "test:integration:postgresql": "vitest run tests/integration/postgresql-*.test.ts --no-file-parallelism"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fastify/formbody": "^9.0.1",
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.6",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.5",
    "mysql2": "^3.24.5",
    "pg": "8.23.1",
    "pg-cursor": "2.22.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "saxes": "5.0.1",
    "unzipper": "0.10.14",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
